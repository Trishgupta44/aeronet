{
  "name": "aeronet-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:public": "node scripts/check-public-bundle.mjs",
    "check:public:strict": "node scripts/check-public-bundle.mjs --withhold",
    "build:public": "npm run check:public && vite build",
    "build:static": "npm run check:public && vite build --mode static",
    "build:static:strict": "npm run check:public:strict && vite build --mode static",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
